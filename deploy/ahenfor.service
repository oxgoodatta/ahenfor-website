# systemd unit for the Ahenfor website (Ubuntu VPS).
# Install:  sudo cp deploy/ahenfor.service /etc/systemd/system/
#           sudo systemctl daemon-reload && sudo systemctl enable --now ahenfor
[Unit]
Description=Ahenfor website (Gunicorn)
After=network.target postgresql.service

[Service]
User=ahenfor
Group=www-data
WorkingDirectory=/srv/ahenfor/app
EnvironmentFile=/srv/ahenfor/app/.env
# One worker process with threads: SQLite has a single writer, and the in-memory
# login rate limiter is shared by every request.
ExecStart=/srv/ahenfor/app/.venv/bin/gunicorn "run:app" \
    --workers 1 \
    --threads 8 \
    --bind 127.0.0.1:8000 \
    --timeout 300 \
    --access-logfile - \
    --error-logfile -
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
