# ---------------------------------------------------------------------------
# Ahenfor website configuration. Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

# development | production   (testing is selected automatically by pytest)
FLASK_CONFIG=development
FLASK_APP=run.py
FLASK_DEBUG=false

# Generate with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-secure-secret

# Public base URL, used for canonical links, the sitemap and emails (no trailing slash)
SITE_URL=http://localhost:5000

# Comma-separated host names the app will answer to in production (blank = any)
ALLOWED_HOSTS=

# Number of reverse proxies in front of the app (1 behind Nginx / Render)
PROXY_FIX_HOPS=0

# Database: leave blank to use SQLite at instance/ahenfor.db (recommended for this site).
# Optional PostgreSQL instead, e.g.: postgresql://ahenfor:password@localhost:5432/ahenfor_db
DATABASE_URL=

# ---- Media storage --------------------------------------------------------
# local | s3 | cloudinary
MEDIA_STORAGE_PROVIDER=local
# Upload folder on the server's disk (blank = instance/uploads). Include it in backups.
LOCAL_MEDIA_ROOT=

MAX_IMAGE_MB=10
MAX_VIDEO_MB=100
MAX_DOCUMENT_MB=15
MAX_REQUEST_MB=150

# S3 / S3-compatible (AWS S3, Cloudflare R2, DigitalOcean Spaces)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_REGION=
# Only for non-AWS providers, e.g. https://<account>.r2.cloudflarestorage.com
S3_ENDPOINT_URL=
# Public URL that serves the bucket's public/ prefix, e.g. https://media.ahenfor.com
MEDIA_PUBLIC_BASE_URL=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- Email -----------------------------------------------------------------
# console (log only, nothing is sent) | smtp
MAIL_BACKEND=console
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=
# Fallback recipient for inquiry notifications (can also be set in Admin > Settings)
INQUIRY_NOTIFY_EMAIL=

# ---- Security --------------------------------------------------------------
SESSION_HOURS=8
# memory:// is per-process. Use redis://localhost:6379/0 with several Gunicorn workers.
RATELIMIT_STORAGE_URI=memory://
